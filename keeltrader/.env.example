# ========== Database ==========
POSTGRES_PASSWORD=choose_a_strong_local_database_password
DB_HOST=postgres-host.example.local
DB_PORT=5432
DB_NAME=keeltrader
DB_USER=keeltrader
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://keeltrader:your_secure_password_here@postgres-host.example.local:5432/keeltrader

# ========== Redis ==========
REDIS_URL=redis://redis-host.example.local:6379/0

# Optional deployment-owned default Agent model. Private deployments must use
# their own gateway/key; no hosted fallback is built into KeelTrader.
AGENT_MANAGED_PROVIDER=openai
AGENT_MANAGED_MODEL=
AGENT_MANAGED_BASE_URL=
AGENT_MANAGED_API_KEY=
AGENT_MODEL_TIMEOUT_SECONDS=300

# ========== Optional external research services ==========
# Self-hosted deployments remain offline unless explicitly enabled.
REPORT_KB_URL=
REPORT_KB_SERVICE_KEY=
TUSHARE_DATABASE_URL=

# Optional per-user Research Cloud connection. It remains disabled unless the
# administrator enables it and supplies the HTTPS service endpoint.
RESEARCH_CLOUD_ENABLED=0
RESEARCH_CLOUD_BASE_URL=
RESEARCH_CLOUD_TIMEOUT_SECONDS=12

# ========== Auth ==========
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_here_minimum_32_characters
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
# Local self-hosting defaults to a single guest workspace without login.
# Set to 1 before binding either API or Web to a non-loopback interface.
KEELTRADER_AUTH_REQUIRED=0
KEELTRADER_API_BIND=127.0.0.1
KEELTRADER_WEB_BIND=127.0.0.1
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEPLOYMENT_MODE=self-hosted

# ========== Application ==========
APP_NAME=Keel Trader
APP_VERSION=0.3.0
APP_ENV=development
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========== Environment ==========
NODE_ENV=development
PYTHON_ENV=development

# ========== Build Registries ==========
# Official registries are the portable defaults. Operators may override these
# in local, untracked environment files when a regional mirror is required.
PIP_INDEX_URL=https://pypi.org/simple/
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# ========== Database migration startup ==========
# Self-hosted installs normally migrate before API startup. Operators with a
# separate migration job may set this to 0.
KEELTRADER_RUN_MIGRATIONS=1
