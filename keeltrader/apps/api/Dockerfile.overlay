ARG OVERLAY_BASE_IMAGE=keeltrader-api:base
FROM ${OVERLAY_BASE_IMAGE}

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG BUILD_TYPE=overlay

LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      com.keeltrader.build_type="${BUILD_TYPE}" \
      com.keeltrader.service="api"

ENV KEELTRADER_GIT_SHA="${GIT_SHA}" \
    KEELTRADER_BUILD_TIME="${BUILD_TIME}" \
    KEELTRADER_BUILD_TYPE="${BUILD_TYPE}"

USER root
WORKDIR /app

RUN find /app -mindepth 1 -maxdepth 1 \
      ! -name ".venv" \
      ! -name "__pycache__" \
      -exec rm -rf {} +

COPY --chown=appuser:appuser apps/ /app/apps/
COPY --chown=appuser:appuser alembic.ini /app/alembic.ini
COPY --chown=appuser:appuser migrations/ /app/migrations/

RUN for item in /app/apps/api/*; do \
      base=$(basename "$item"); \
      [ "$base" = "Dockerfile" ] && continue; \
      [ "$base" = "Dockerfile.overlay" ] && continue; \
      [ "$base" = "Dockerfile.test" ] && continue; \
      [ "$base" = "__pycache__" ] && continue; \
      ln -sfn "$item" "/app/$base"; \
    done && \
    find /app/apps/api -name "*.sh" -exec sed -i 's/\r$//' {} \;

USER appuser

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
