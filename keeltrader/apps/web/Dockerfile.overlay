ARG OVERLAY_BASE_IMAGE=keeltrader-web:base
FROM ${OVERLAY_BASE_IMAGE}

USER root
WORKDIR /app

RUN rm -rf .next app components hooks lib types public proxy.ts next.config.js

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node public ./public
COPY --chown=node:node .next ./.next
COPY --chown=node:node app ./app
COPY --chown=node:node components ./components
COPY --chown=node:node hooks ./hooks
COPY --chown=node:node lib ./lib
COPY --chown=node:node types ./types
COPY --chown=node:node proxy.ts ./proxy.ts
COPY --chown=node:node next.config.js ./next.config.js

USER node

CMD ["npm", "start", "--", "-p", "3000", "-H", "0.0.0.0"]
